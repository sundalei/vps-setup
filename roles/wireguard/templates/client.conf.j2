{# Generated by playbooks/wireguard-client.yml -- do not edit by hand.
   Regenerate after any node rebuild: a reinstalled host gets a NEW keypair,
   and a stale PublicKey here fails silently with no handshake. #}
[Interface]
PrivateKey = {{ lookup('file', wg_client_key_file) | trim }}
Address = {{ wg_client_ip }}/32
{% for h in groups['wireguard_mesh'] | sort %}

[Peer]
# {{ h }}
PublicKey = {{ hostvars[h].wg_public_key_value }}
AllowedIPs = {{ hostvars[h].wg_ip }}/32
Endpoint = {{ hostvars[h].wg_public_endpoint }}:{{ wg_port }}
PersistentKeepalive = 25
{% endfor %}
